{
  "manifest_version": 3,
  "name": "Overwatch",
  "version": "1.6",
  "description": "Shows when the current YouTube video will end.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  
  "icons": {
    "16": "assets/overwatch16.png",
    "32": "assets/overwatch32.png",
    "48": "assets/overwatch48.png",
    "128": "assets/overwatch128.png"
  },
  
  "permissions": []
}
